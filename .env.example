# Environment Configuration for EMS (Employee Management System)

# Environment Mode (dev / staging / production)
ENVIRONMENT=dev

# Application Ports
WEB_PORT=3200
API_PORT=8200

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=ems_password_secure_123
POSTGRES_DB=ems_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ems_user:ems_password_secure_123@localhost:5432/ems_db

# Cache Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_ems_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Mail Configuration (Gmail SMTP)
SMTP_PROVIDER=Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=SSL
SMTP_USER=oneuni@gmail.com
SMTP_PASSWORD=your_16_character_app_password_here
DEFAULT_FROM_EMAIL=oneuni@gmail.com

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

# Seed Data Toggle (true for development seeding)
SEED_DEMO=true
